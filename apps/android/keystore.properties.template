# Release keystore configuration.
# Copy this file to keystore.properties (sibling of this template) and fill in real values.
# keystore.properties is gitignored — never commit it.

# Path to the .jks / .keystore file, relative to this directory.
storeFile=release.jks

# Keystore password.
storePassword=REPLACE_ME

# Key alias inside the keystore.
keyAlias=release

# Key password.
keyPassword=REPLACE_ME
